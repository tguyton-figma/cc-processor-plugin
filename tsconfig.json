{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "types": ["@figma/plugin-typings"],
    "moduleResolution": "bundler",
    "module": "ESNext",
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["code.ts", "src/**/*.ts", "src/**/*.d.ts"]
}
