{
  "name": "cc-processor",
  "version": "0.0.0",
  "private": true,
  "description": "Code Connect Figma plugin (main thread: code.ts, UI: ui.html)",
  "scripts": {
    "build": "esbuild code.ts --bundle --outfile=code.js --target=es2017 --loader:.svg=text && node .figma/make/build-ui.mjs",
    "build:ui": "node .figma/make/build-ui.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@lezer/javascript": "^1.5.4",
    "@phosphor-icons/core": "^2.1.1"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.109.0",
    "esbuild": "^0.24.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
